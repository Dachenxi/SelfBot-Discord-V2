{
  "name": "SelfBot-Discord-V2",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env src/index.ts",
    "dev:web": "tsx --env-file=.env src/index.ts --only-web",
    "dev:bot": "tsx --env-file=.env src/index.ts --only-bot",
    
    "start": "node dist/index.js" 
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3",
    "tsx": "^4.22.4" 
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "debug": "^4.4.3",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5"
  }
}